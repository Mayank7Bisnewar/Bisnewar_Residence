rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure the 'users' collection
    match /users/{userId} {
      // Only allow the user to read and write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // If you have subcollections, you can secure them similarly:
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Secure public tenant views
    match /public_tenant_views/{accessKey} {
      // Allow anyone to fetch their specific document if they know the key
      allow get: if true;
      // Do not allow listing all documents
      allow list: if false;
      // Only the landlord who owns this view can update/delete it
      allow write: if request.auth != null && request.auth.uid == request.resource.data.landlordUid;
      // For updates and deletes, check existing resource
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.landlordUid;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
