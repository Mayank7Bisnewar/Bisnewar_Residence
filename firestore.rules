rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure the 'users' collection
    match /users/{userId} {
      // Only allow the user to read and write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // If you have subcollections, you can secure them similarly:
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Secure public tenant views
    match /public_tenant_views/{accessKey} {
      // Allow anyone to fetch their specific document if they know the key
      allow get: if true;
      // Do not allow listing all documents
      allow list: if false;
      // Only the landlord who owns this view can create/delete it
      allow create, delete: if request.auth != null && request.auth.uid == request.resource.data.landlordUid;
      // Allow landlord to update, or allow tenant to update ONLY their fcmToken
      allow update: if (request.auth != null && request.auth.uid == resource.data.landlordUid) 
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']);
    }

    // Secure notification requests
    match /notification_requests/{reqId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.landlordUid;
      allow read, update, delete: if false;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
